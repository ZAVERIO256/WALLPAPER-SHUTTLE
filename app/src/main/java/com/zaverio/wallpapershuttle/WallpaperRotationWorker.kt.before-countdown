package com.zaverio.wallpapershuttle

import android.app.WallpaperManager
import android.content.Context
import android.net.Uri
import androidx.documentfile.provider.DocumentFile
import androidx.work.ExistingWorkPolicy
import androidx.work.OneTimeWorkRequestBuilder
import androidx.work.WorkManager
import androidx.work.Worker
import androidx.work.WorkerParameters
import java.util.ArrayDeque
import java.util.concurrent.TimeUnit

class WallpaperRotationWorker(
    context: Context,
    params: WorkerParameters
) : Worker(context, params) {

    companion object {
        const val WORK_NAME = "wallpaper_rotation_chain"
        private const val PREFS = "shuffle_wallpaper"
    }

    private fun collectImages(root: DocumentFile): List<Uri> {
        val images = mutableListOf<Uri>()
        val folders = ArrayDeque<DocumentFile>()
        folders.add(root)

        while (folders.isNotEmpty()) {
            val folder = folders.removeFirst()

            val files = try {
                folder.listFiles()
            } catch (_: Exception) {
                continue
            }

            for (file in files) {
                try {
                    if (file.isDirectory) {
                        folders.add(file)
                    } else if (file.isFile && isImage(file)) {
                        images.add(file.uri)
                    }
                } catch (_: Exception) {
                    // Skip inaccessible entries.
                }
            }
        }

        return images
    }

    private fun isImage(file: DocumentFile): Boolean {
        if (file.type?.startsWith("image/", ignoreCase = true) == true) {
            return true
        }

        val name = file.name?.lowercase() ?: return false

        return listOf(
            ".jpg", ".jpeg", ".png",
            ".webp", ".gif", ".bmp"
        ).any { name.endsWith(it) }
    }

    override fun doWork(): Result {
        val preferences = applicationContext.getSharedPreferences(
            PREFS,
            Context.MODE_PRIVATE
        )

        if (!preferences.getBoolean("rotation_enabled", false)) {
            return Result.success()
        }

        val status = try {
            val folderString = preferences.getString("folder_uri", null)
                ?: throw IllegalStateException("No image folder selected.")

            val folder = DocumentFile.fromTreeUri(
                applicationContext,
                Uri.parse(folderString)
            ) ?: throw IllegalStateException("Selected folder is unavailable.")

            val images = collectImages(folder)

            val excluded = preferences.getStringSet(
                "excluded_uris",
                emptySet()
            ) ?: emptySet()

            val eligibleImages = images.filterNot {
                it.toString() in excluded
            }

            if (eligibleImages.isEmpty()) {
                throw IllegalStateException(
                    "No eligible images. Check your exclusions."
                )
            }

            // Fully random: repeated images are allowed.
            val chosenImage = eligibleImages.random()

            val destination = preferences.getInt(
                "destination",
                WallpaperManager.FLAG_SYSTEM or WallpaperManager.FLAG_LOCK
            )

            val displayMode = preferences.getString(
                "display_mode",
                "crop"
            ) ?: "crop"

            WallpaperImageProcessor.apply(
                applicationContext,
                chosenImage,
                displayMode,
                destination
            )

            preferences.edit()
                .putString("last_image_uri", chosenImage.toString())
                .putLong("last_rotation_time", System.currentTimeMillis())
                .apply()

            AppStorage.addHistory(applicationContext, chosenImage)

            "Wallpaper changed successfully."
        } catch (e: Exception) {
            "Rotation issue: ${e.message ?: "Unknown error"}"
        }

        preferences.edit()
            .putString("last_rotation_status", status)
            .apply()

        scheduleNextRotation(preferences)

        return Result.success()
    }

    private fun scheduleNextRotation(
        preferences: android.content.SharedPreferences
    ) {
        if (!preferences.getBoolean("rotation_enabled", false)) {
            return
        }

        val interval = preferences.getInt("interval", 30)
            .coerceIn(1, 1440)

        val nextWork = OneTimeWorkRequestBuilder<WallpaperRotationWorker>()
            .setInitialDelay(interval.toLong(), TimeUnit.MINUTES)
            .addTag(WORK_NAME)
            .build()

        WorkManager.getInstance(applicationContext).enqueueUniqueWork(
            WORK_NAME,
            ExistingWorkPolicy.APPEND_OR_REPLACE,
            nextWork
        )
    }
}
